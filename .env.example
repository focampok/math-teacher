# Local default is SQLite (no Docker required).
# Railway / docker-compose: postgres+psycopg://studykit:studykit@postgres:5432/studykit
DATABASE_URL=sqlite:///./data/studykit.sqlite

# Shared secret for upload / publish / preview of unpublished kits.
UPLOAD_TOKEN=change-me

# Where source files and generated HTML are stored (Railway Volume → /data).
DATA_DIR=./data

# Public origin used in emails/logs and absolute kit URLs.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional. Leave empty to use StubCompiler (no API key needed).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Worker (embedded in the web process by default; no Redis, no second service)
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=180
WORKER_ID=local-1
RUN_EMBEDDED_WORKER=true
